APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_MODE=combined
# Empty trusts no proxies; Render sets *. Fixed ingress can use IPs/CIDRs.
TRUSTED_PROXIES=
DEMO_TTL_HOURS=24
DEMO_MAX_ACTIVE=100
DEMO_MAX_WRITES=5000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Segurança: enviar HSTS apenas com HTTPS real em produção (proxy TLS correto).
SECURITY_HSTS_ENABLED=false

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produção: OBRIGATÓRIO true (cookie de sessão só viaja em HTTPS). Em dev local fica false/null.
SESSION_SECURE_COOKIE=false

# CORS: necessário com supports_credentials (cookie de sessão). Listar origens do front (ex. Vite).
# Em dev com proxy do Vite para a mesma origem, ainda pode ser necessário se usar VITE_API_BASE_URL noutro host.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sanctum SPA: hosts do frontend que enviam cookies de sessão (vírgula, sem esquema).
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp    # Dev: use Mailpit (smtp://127.0.0.1:1025). Prod: SES, Postmark, Resend etc.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OpenAPI / Swagger UI (darkaonline/l5-swagger)
# Em produção manter false e gerar com `php artisan l5-swagger:generate`.
# true regenera o JSON a cada pedido (custo + risco) — usar só em dev.
L5_SWAGGER_GENERATE_ALWAYS=false
L5_FORMAT_TO_USE_FOR_DOCS=json
# Documentação Swagger fica bloqueada em produção a menos que explicitamente ativada (idealmente atrás de VPN/SSO).
API_DOCS_ENABLED=false
