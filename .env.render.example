APP_NAME="Agency Hub"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_MODE=combined
TRUSTED_PROXIES=*
APP_URL=https://agency-hub.onrender.com
ASSET_URL=https://agency-hub.onrender.com
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
AIVEN_CA_CERT=
MYSQL_ATTR_SSL_CA=/tmp/agency-hub-aiven-ca.pem
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SECURITY_HSTS_ENABLED=true
CORS_ALLOWED_ORIGINS=https://agency-hub.onrender.com
SANCTUM_STATEFUL_DOMAINS=agency-hub.onrender.com
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public
DEMO_TTL_HOURS=24
DEMO_MAX_ACTIVE=100
DEMO_MAX_WRITES=5000
API_DOCS_ENABLED=false
LOG_CHANNEL=stderr
LOG_LEVEL=warning
